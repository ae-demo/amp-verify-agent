{
  "name": "ticket-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "ticket-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7
  ],
  "description": "Owns tickets and their drafted/approved replies. Accepts public ticket submissions, calls triage-agent to classify urgency and draft a reply, serves the signed-in support agent's queue and detail views, and on approval sends the reply via email-service. Holds no UI and does not itself classify or draft text.",
  "dependencies": [
    {
      "kind": "component",
      "name": "triage-agent",
      "description": "Classifies a newly submitted ticket's urgency and drafts a reply.",
      "wiring": {
        "endpoint": {
          "component": "amp-verify-agent-triage-agent",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TRIAGE_AGENT_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "ticket-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "amp-verify-agent-ticket-db",
        "envBindings": {
          "dbname": "TICKET_DB_DBNAME",
          "host": "TICKET_DB_HOST",
          "password": "TICKET_DB_PASSWORD",
          "port": "TICKET_DB_PORT",
          "user": "TICKET_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "amp-verify-agent-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "external",
      "name": "email-service",
      "description": "Sends the approved reply to the customer by email.",
      "wiring": {
        "ref": "amp-verify-agent-6f87ade2",
        "envBindings": {
          "EMAIL_SERVICE_BASE_URL": "EMAIL_SERVICE_BASE_URL"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
