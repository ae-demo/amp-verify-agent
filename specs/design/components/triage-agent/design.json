{
  "name": "triage-agent",
  "type": "ai-agent",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "triage-agent",
  "entrypoint": "deployment/ai-agent",
  "exposure": "internet",
  "stories": [
    2,
    4
  ],
  "description": "Given a ticket's subject and body, classifies its urgency (Low/Medium/High/Critical) and drafts a reply for a support agent to review. ticket-api calls it in-cluster with the ticket id. The console Try it page calls it as the signed-in user, so the gateway maps that token onto x-user-id. Holds no ticket data beyond its own conversation store.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "memory-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "amp-verify-agent-memory-db",
        "envBindings": {
          "dbname": "MEMORY_DB_DBNAME",
          "host": "MEMORY_DB_HOST",
          "password": "MEMORY_DB_PASSWORD",
          "port": "MEMORY_DB_PORT",
          "user": "MEMORY_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "amp-verify-agent-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "agent-building"
  ]
}
