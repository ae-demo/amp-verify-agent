{
  "name": "triage-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "triage-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    3,
    4,
    5,
    6
  ],
  "description": "The single-page app customers use to submit a support ticket (public, no sign-in) and support agents use to sign in, review their triage queue sorted by urgency, and edit and approve AI-drafted replies. Talks only to ticket-api; holds no data of its own.",
  "dependencies": [
    {
      "kind": "component",
      "name": "ticket-api",
      "description": "Submits tickets, lists the triage queue, and edits/approves drafted replies.",
      "wiring": {
        "endpoint": {
          "component": "amp-verify-agent-ticket-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TICKET_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "amp-verify-agent-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
